{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "vcekCert": {
      "type": "string"
    },
    "tcbm": {
      "type": "string",
      "pattern": "^[0-9A-F]+$"
    },
    "certificateChain": {
      "type": "string"
    },
    "cacheControl": {
      "type": "string"
    }
  },
  "required": [
    "vcekCert",
    "tcbm",
    "certificateChain",
    "cacheControl"
  ]
}
