using './stress_tests_cwcow.bicep'

// Image info — tag retained for c-aci-testing parameter parity; ignored
// because the nanoserver image is digest-pinned in the bicep template.
param tag = ''

// Deployment info
param location = 'westeurope'

// Pre-populated permissive WCOW policy (api_version 0.11.0, mount_cims).
// Matches the wcow_allow_all_policy.rego template emitted by
// `c-aci-testing policies gen ... --policy-type allow_all`. Sufficient for
// VM-level testing.
param ccePolicies = {
  stress_tests_cwcow: ''
}
